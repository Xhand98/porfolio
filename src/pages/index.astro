---
import Card from "../components/Card.astro";
import Layout from "../layouts/Layout.astro";
import * as locale from "../locales/projects.json";
---

<Layout title="Hendrick.dev">
    <main class="flex flex-col items-center justify-start px-5 py-12 relative">
        <div class="w-full max-w-sm flex flex-col items-center">
            <div
                id="cube"
                class="w-[384px] h-[153px] bg-[#faa61a] rounded-xl flex justify-center mb-14"
            >
                <img
                    src="https://avatars.githubusercontent.com/u/78098509?v=4"
                    class="rounded-full w-20 h-20 border-4 border-white mt-28 aspect-auto"
                    alt="My pfp"
                />
            </div>

            <h1 class="title">Hendrick.dev</h1>
            <p class="text-gray-300 text-sm text-pretty text-center">
                Hello, I'm <span class="text-[#faa61a]">Hendrick</span> a hobbyist
                web developer/designer from the Dominican Republic, here are some
                projects I've worked on.
            </p>
            <div class="gap-8 flex flex-col items-center">
                <div class="flex flex-col gap-2 w-full">
                    <h2 class="subtitle">Projects</h2>
                    {locale.projects.map((project: {title: string, body: string, href: string, svg: string}) => (
                            <Card
                                title={project.title}
                                body={project.body}
                                href={project.href}
                                svg={project.svg}
                            />
                    ))}
                </div>

                <div class="flex flex-col gap-2 w-full">
                    <h2 class="subtitle">Donate</h2>
                    {locale.Donations.map((e: {title: string, body: string, href: string, svg: string}) => (
                        <Card
                            title={e.title}
                            body={e.body}
                            href={e.href}
                            svg={e.svg}
                        />
                    ))}
                </div>
                <div class="h-px w-96 bg-zinc-600"></div>
            </div>
        </div>
    </main>
</Layout>

<style>
    .title {
        font-size: theme(fontSize.2xl);
        font-weight: theme(fontWeight.bold);
        color: theme(textColor.white);
    }

    .subtitle {
        font-size: theme(fontSize.xl);
        font-weight: theme(fontWeight.semibold);
        color: theme(textColor.white);
    }
</style>
